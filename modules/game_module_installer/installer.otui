InstallerPreview < MainWindow
  !text: tr('Screenshot')
  size: 660 420
  @onEscape: self:destroy()

  UIWidget
    id: image
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 640 360
    image-smooth: false
    phantom: true

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 80 24
    @onClick: self:getParent():destroy()

InstallerCard < Panel
  size: 244 210
  border-width: 1
  border-color: #444444
  background-color: #00000044
  padding: 4

  UIWidget
    id: shotBox
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 134
    background-color: #00000066

    UIWidget
      id: shot
      anchors.centerIn: parent
      size: 236 132
      image-smooth: true

    Label
      id: noShot
      anchors.centerIn: parent
      text: no screenshot
      color: #666666
      font: verdana-9px
      phantom: true

  Label
    id: title
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 14
    text-align: left
    color: #ffdd55

  Label
    id: description
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    text-align: left
    text-wrap: true
    color: #cccccc
    font: verdana-9px

  Panel
    id: buttons
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22

    Button
      id: install
      anchors.top: parent.top
      anchors.left: parent.left
      size: 112 22

    Button
      id: remove
      anchors.top: parent.top
      anchors.right: parent.right
      size: 112 22
      !text: tr('Remove')

MainWindow
  id: moduleInstallerWindow
  !text: tr('Modules')
  size: 560 640
  // mouse hit-testing stops at the padding rect, so the frame cannot hold resize grips: shrink the right and
  // bottom padding to 2 px, push the content back with margins and place the grips in the freed strip
  padding-right: 2
  padding-bottom: 2
  @onEscape: modules.game_module_installer.hide()

  ScrollablePanel
    id: list
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: listScroll.left
    anchors.bottom: status.top
    margin-bottom: 6
    margin-right: 4
    vertical-scrollbar: listScroll
    layout:
      type: grid
      cell-size: 244 210
      cell-spacing: 6
      flow: true

  VerticalScrollBar
    id: listScroll
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: status.top
    margin-bottom: 6
    margin-right: 14
    step: 60
    pixels-scroll: true

  Label
    id: status
    anchors.bottom: refresh.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 6
    margin-right: 14
    height: 28
    text-align: left
    text-wrap: true

  Button
    id: refresh
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 14
    size: 110 24
    !text: tr('Refresh list')

  Button
    id: reload
    anchors.bottom: parent.bottom
    anchors.left: refresh.right
    margin-left: 6
    margin-bottom: 14
    size: 120 24
    !text: tr('Reload modules')
    !tooltip: tr('Same as Ctrl+Shift+R: reloads every loaded module')
    @onClick: modules.game_module_installer.reloadAll()

  Button
    id: github
    anchors.bottom: parent.bottom
    anchors.right: closeButton.left
    margin-right: 6
    margin-bottom: 14
    size: 110 24
    !text: tr('Open GitHub')
    @onClick: modules.game_module_installer.openRepo()

  Button
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 14
    margin-right: 14
    size: 80 24
    !text: tr('Close')
    @onClick: modules.game_module_installer.hide()

  ResizeBorder
    id: bottomResizeBorder
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-right: 14
    height: 8
    minimum: 320
    maximum: 1400

  ResizeBorder
    id: rightResizeBorder
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-bottom: 14
    width: 8
    minimum: 460
    maximum: 1600

  UIWidget
    id: cornerGrip
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 14 14
    image-source: grip.png
    opacity: 0.7
    !tooltip: tr('Drag to resize')

    $hover:
      opacity: 1
