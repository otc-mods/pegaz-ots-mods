InstallerPreview < MainWindow
  !text: tr('Screenshot')
  size: 660 420
  @onEscape: self:destroy()

  UIWidget
    id: image
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 640 360
    image-smooth: false
    phantom: true

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 80 24
    @onClick: self:getParent():destroy()

InstallerCard < Panel
  size: 244 262
  border-width: 1
  border-color: #444444
  background-color: #00000044
  padding: 4

  UIWidget
    id: shotBox
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 134
    background-color: #00000066

    UIWidget
      id: shot
      anchors.centerIn: parent
      size: 236 132
      image-smooth: true

    Label
      id: noShot
      anchors.centerIn: parent
      text: no screenshot
      color: #666666
      font: verdana-9px
      phantom: true

  Label
    id: title
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 16
    text-align: left
    color: #ffdd55

  Label
    id: description
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    text-align: left
    text-wrap: true
    color: #cccccc
    font: verdana-9px

  Label
    id: versions
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    text-align: left
    text-wrap: true
    font: verdana-9px
    color: #a0a0a0

  Panel
    id: buttons
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22

    Button
      id: install
      anchors.top: parent.top
      anchors.left: parent.left
      size: 112 22

    Button
      id: remove
      anchors.top: parent.top
      anchors.right: parent.right
      size: 112 22
      !text: tr('Remove')

MainWindow
  id: moduleInstallerWindow
  !text: tr('Modules')
  size: 560 640
  @onEscape: modules.game_module_installer.hide()

  Label
    id: source
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: left
    font: verdana-9px
    color: #a0a0a0
    height: 14

  ScrollablePanel
    id: list
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: listScroll.left
    anchors.bottom: status.top
    margin-top: 4
    margin-bottom: 6
    margin-right: 4
    vertical-scrollbar: listScroll
    layout:
      type: grid
      cell-size: 244 262
      cell-spacing: 6
      flow: true

  VerticalScrollBar
    id: listScroll
    anchors.top: source.bottom
    anchors.right: parent.right
    anchors.bottom: status.top
    margin-top: 4
    margin-bottom: 6
    step: 60
    pixels-scroll: true

  Label
    id: status
    anchors.bottom: refresh.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 6
    height: 28
    text-align: left
    text-wrap: true

  Button
    id: refresh
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 110 24
    !text: tr('Refresh list')

  Button
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 80 24
    !text: tr('Close')
    @onClick: modules.game_module_installer.hide()
