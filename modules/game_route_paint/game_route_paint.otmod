Module
  name: game_route_paint
  description: Waypoint editor on the map - draw an area for goto waypoints, place and edit every cavebot waypoint type
  author: otc-mods
  website: local
  sandboxed: true
  autoload: true
  autoload-priority: 1000
  dependencies: [ game_interface, client_topmenu, game_minimap ]
  scripts: [ png, cfg, types, bags, depot, library, main ]
  @onLoad: init()
  @onUnload: terminate()
