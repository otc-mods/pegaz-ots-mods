TopButtonsRow < UIWidget
  height: 22
  focusable: false

  UILabel
    id: label
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 27
    margin-right: 4
    text-align: left
    phantom: true

TopButtonsDragRow < UIWidget
  height: 28
  draggable: true
  focusable: false

  Button
    id: rightArrow
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    size: 18 18
    !text: tr('>')
    !tooltip: tr('Move one column to the right')

  Button
    id: leftArrow
    anchors.right: rightArrow.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    size: 18 18
    !text: tr('<')
    !tooltip: tr('Move one column to the left')

  UILabel
    id: name
    anchors.left: parent.left
    anchors.right: leftArrow.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 30
    margin-right: 4
    text-align: left
    phantom: true

TopButtonsColumn < ScrollablePanel
  border-width: 1
  border-color: #202327
  padding: 2
  layout:
    type: verticalBox

TopButtonsSettings < MainWindow
  id: topButtonsSettings
  !text: tr('Buttons')
  size: 580 520

  UILabel
    id: hint
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    text-wrap: true
    text-align: left
    color: #b0b0b0
    !text: tr('Use < and > to move a button between columns. Dragging works too.')

  UILabel
    id: favHead
    anchors.top: hint.bottom
    anchors.left: parent.left
    width: 178
    height: 18
    text-align: center
    !text: tr('Favourites (icons)')

  UILabel
    id: listHead
    anchors.top: hint.bottom
    anchors.left: favHead.right
    margin-left: 8
    width: 178
    height: 18
    text-align: center
    !text: tr('List (rows)')

  UILabel
    id: offHead
    anchors.top: hint.bottom
    anchors.left: listHead.right
    margin-left: 8
    width: 178
    height: 18
    text-align: center
    !text: tr('Hidden')

  VerticalScrollBar
    id: favScroll
    anchors.top: favHead.bottom
    anchors.bottom: closeBtn.top
    anchors.left: favHead.right
    margin-bottom: 8
    margin-left: -12
    step: 20
    pixels-scroll: true

  TopButtonsColumn
    id: favCol
    anchors.top: favHead.bottom
    anchors.bottom: closeBtn.top
    anchors.left: favHead.left
    anchors.right: favScroll.left
    margin-bottom: 8
    vertical-scrollbar: favScroll

  VerticalScrollBar
    id: listScroll
    anchors.top: listHead.bottom
    anchors.bottom: closeBtn.top
    anchors.left: listHead.right
    margin-bottom: 8
    margin-left: -12
    step: 20
    pixels-scroll: true

  TopButtonsColumn
    id: listCol
    anchors.top: listHead.bottom
    anchors.bottom: closeBtn.top
    anchors.left: listHead.left
    anchors.right: listScroll.left
    margin-bottom: 8
    vertical-scrollbar: listScroll

  VerticalScrollBar
    id: offScroll
    anchors.top: offHead.bottom
    anchors.bottom: closeBtn.top
    anchors.left: offHead.right
    margin-bottom: 8
    margin-left: -12
    step: 20
    pixels-scroll: true

  TopButtonsColumn
    id: offCol
    anchors.top: offHead.bottom
    anchors.bottom: closeBtn.top
    anchors.left: offHead.left
    anchors.right: offScroll.left
    margin-bottom: 8
    vertical-scrollbar: offScroll

  Button
    id: closeBtn
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 80 24
    !text: tr('Close')

  Button
    id: resetBtn
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    margin-right: 6
    size: 110 24
    !text: tr('All to List')

MiniWindow
  id: topButtonsWindow
  !text: tr('Buttons')
  icon: /images/topbuttons/buttons
  height: 200
  &save: true

  UIWidget
    id: settingsButton
    anchors.verticalCenter: minimizeButton.verticalCenter
    anchors.right: minimizeButton.left
    margin-right: 5
    size: 12 12
    image-source: cog.png
    image-smooth: true
    phantom: false

  TextEdit
    id: search
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 22
    margin-left: 3
    margin-right: 3
    height: 20
    placeholder: Search buttons
    placeholder-color: #7a7a7a

  MiniWindowContents
    Panel
      id: rows
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      layout:
        type: verticalBox
        fit-children: true

TopFavsWindow < MiniWindow
  id: topFavsWindow
  !text: tr('Favourites')
  icon: /images/topbuttons/buttons
  height: 60
  &save: true

  MiniWindowContents
    Panel
      id: favs
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      layout:
        type: grid
        cell-size: 28 28
        cell-spacing: 2
        flow: true
        fit-children: true
